rules_version = '2';
// DHS Logistics - Orders Dashboard (Alpha): who can read and change what.
// Designations live in the "members" collection: document ID = the person's email in lower case, field "role".
// The stored role keys are unchanged from earlier versions; only the names shown in the app changed:
//   admin    = Admin       : everything
//   dispatch = Supervisor  : add/change any order not yet dispatched; mark dispatched, correct dispatch time,
//                            undo dispatch; add dealers; add vehicles and tracking links
//   desk     = Dispatch    : add orders; change details only of their own orders entered today (not dispatched);
//                            mark dispatched and undo dispatch; add vehicles and tracking links
//   Admin, Supervisor and Dispatch can all: cancel any undispatched order (who cancelled is recorded and can't be faked),
//   put it on hold and release it, change its delivery date or send it to today.
//   An order on hold can't be dispatched; an advance order can't be dispatched before its day; dispatching needs the
//   customer's phone number, a vehicle number and a dispatch depot.
//   viewer   = Viewer      : read only (no vehicles / tracking links)
// Only Admin: change order times, change dispatched orders, delete orders, remove dealers or vehicles, the team, emails.
// Every change to an order records who made it (updatedBy) and when (updatedAt).
// One device per account: each member record keeps the time of the newest sign-in ("sess", seconds);
// a device whose sign-in is older gets no access.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function me() { return get(memberPath()).data; }
    function current() { return me().get('sess', 0) <= request.auth.token.auth_time; }
    function role() {
      return signedIn() && exists(memberPath()) && current() ? me().role : 'none';
    }
    function isMember()  { return role() in ['admin', 'dispatch', 'desk', 'viewer']; }
    function canOrder()  { return role() in ['admin', 'dispatch', 'desk']; }
    function isAdmin()   { return role() == 'admin'; }
    function isSup()     { return role() == 'dispatch'; }
    function isViewer()  { return role() == 'viewer'; }

    // An order must carry its day (YYYY-MM-DD) and an "open" flag that matches its status,
    // because the dashboard's queue and daily lists are built from those two fields.
    function consistent(d) {
      return d.day is string && d.day.size() == 10
        && d.open == (d.get('mark', '') != 'Cancelled' && d.get('dispatchedAt', null) == null)
        // an order on hold can't be dispatched
        && !(d.get('hold', false) == true && d.get('dispatchedAt', null) != null)
        // dispatch depot: empty, or one of the depots
        && d.get('depot', '') in ['', 'Transport Nagar', 'Harrawala', 'Doiwala'];
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Each change must be signed by the person making it. The one exception is the Admin's one-time upgrade of old orders.
    function stamped() { return request.resource.data.get('updatedBy', '') == myEmail() && request.resource.data.get('updatedAt', 0) is number; }
    function upgradeOnly() { return isAdmin() && changed().hasOnly(['day', 'open', 'dispatchedAt', 'dispatchedBy']); }

    // Order time must be "now" for everyone except the Admin (30 minutes' leeway for a slow connection or phone clock).
    function nowish(t) { return t is number && t > request.time.toMillis() - 1800000 && t < request.time.toMillis() + 300000; }
    // Start of today in India (UTC+5:30), in milliseconds.
    function todayStart() { return math.floor((request.time.toMillis() + 19800000) / 86400000.0) * 86400000 - 19800000; }

    // Dispatch actions: mark dispatched, undo dispatch, correct the dispatch time.
    function onlyDispatchFields() { return changed().hasOnly(['dispatchedAt', 'dispatchedBy', 'open', 'updatedBy', 'updatedAt']); }
    function dispatchOk() {
      return isSup()
        // Dispatch may mark dispatched or undo, but not move an existing dispatch time
        || resource.data.get('dispatchedAt', null) == null
        || request.resource.data.get('dispatchedAt', null) == null;
    }
    // Marking an order dispatched needs the customer's phone number, a vehicle number and a dispatch depot (the one-time upgrade of old records is exempt).
    function newlyDispatched() {
      return resource.data.get('dispatchedAt', null) == null && request.resource.data.get('dispatchedAt', null) != null;
    }
    function hasPhone() {
      return request.resource.data.get('phone', '') is string && request.resource.data.get('phone', '').matches('^[^0-9]*([0-9][^0-9]*){10,}$');
    }
    function hasDepot() {
      return request.resource.data.get('depot', '') in ['Transport Nagar', 'Harrawala', 'Doiwala'];
    }
    function hasVehicle() {
      return request.resource.data.get('vehicle', '') is string && request.resource.data.get('vehicle', '').matches('.*[A-Za-z0-9].*');
    }
    // Dispatching may fill in the vehicle, driver and depot at the same time (anyone who can mark dispatched).
    function dispatchWithVehicle() {
      return newlyDispatched() && changed().hasOnly(['dispatchedAt', 'dispatchedBy', 'open', 'vehicle', 'driver', 'driverPhone', 'depot', 'phone', 'updatedBy', 'updatedAt']);
    }
    // Put on hold / release: Admin, Supervisor and Dispatch, on any order not yet dispatched.
    function holdOk() {
      return changed().hasOnly(['hold', 'holdAt', 'holdBy', 'holdNote', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('hold', false) is bool
        && resource.data.get('dispatchedAt', null) == null;
    }
    // Cancelling: Admin, Supervisor and Dispatch, on any order not yet dispatched.
    function cancelOk() {
      return changed().hasOnly(['mark', 'open', 'hold', 'cancelNote', 'cancelledBy', 'cancelledAt', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('mark', '') == 'Cancelled'
        && resource.data.get('dispatchedAt', null) == null;
    }
    // Whoever cancels an order is recorded, with the time; nobody can write someone else's name there.
    function newlyCancelled() {
      return resource.data.get('mark', '') != 'Cancelled' && request.resource.data.get('mark', '') == 'Cancelled';
    }
    function cancelRecordOk() {
      return (!newlyCancelled() || (request.resource.data.get('cancelledBy', '') == myEmail() && nowish(request.resource.data.get('cancelledAt', 0))))
        && (!changed().hasAny(['cancelledBy', 'cancelledAt']) || request.resource.data.get('cancelledBy', '') == myEmail());
    }
    // Changing details or cancelling: not after dispatch, order time unchanged;
    // Dispatch only on their own orders from today.
    // Advance orders: schedAt = start of the day the order is meant to go (a number), never in the past when set.
    function schedValid(d) { return d.get('schedAt', null) == null || (d.schedAt is number && d.schedAt >= todayStart()); }
    // Change the delivery date, or send to today: Admin, Supervisor and Dispatch, any order not yet dispatched.
    function schedOk() {
      return changed().hasOnly(['schedAt', 'day', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('schedAt', null) is number
        && schedValid(request.resource.data)
        && resource.data.get('dispatchedAt', null) == null;
    }
    // Nobody can mark an advance order dispatched before its day (send it to today first).
    function notBeforeItsDay() {
      return request.resource.data.get('schedAt', null) == null || request.resource.data.schedAt <= request.time.toMillis();
    }
    function detailsOk() {
      return !changed().hasAny(['dispatchedAt', 'dispatchedBy', 'orderAt', 'day', 'schedAt'])
        && resource.data.get('dispatchedAt', null) == null
        && (isSup() || (resource.data.get('createdBy', '') == myEmail() && resource.data.orderAt >= todayStart()));
    }

    // Team list: everyone on the team can see it (for names); only Admin adds, removes or changes designations.
    // Each person may only record their own sign-in on their own record, and only a newer one.
    match /members/{email} {
      allow read: if isMember() || (signedIn() && email == myEmail());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && email == myEmail()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sess', 'sessAt', 'device'])
        && request.resource.data.sess == request.auth.token.auth_time
        && request.resource.data.sess > resource.data.get('sess', 0));
    }

    // Settings. "report" (email lists) is Admin-only; "vehicles" is hidden from Viewers.
    // Dealers: Admin changes freely; a Supervisor may only add one at the end of the list.
    // Vehicles: Admin changes freely; Supervisor and Dispatch may add or update, but the list can't get shorter.
    match /config/{docId} {
      allow read: if isMember() && (docId != 'report' || isAdmin()) && (docId != 'vehicles' || !isViewer());
      allow write: if isAdmin()
        || (docId == 'dealers' && isSup() && resource != null
            && request.resource.data.list.size() == resource.data.list.size() + 1
            && request.resource.data.list[0:resource.data.list.size()] == resource.data.list)
        || (docId == 'vehicles' && canOrder()
            && (resource == null || request.resource.data.list.size() >= resource.data.list.size()));
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isMember();
      allow create: if canOrder()
        && request.resource.data.createdBy == myEmail()
        && consistent(request.resource.data)
        && request.resource.data.get('dispatchedAt', null) == null
        && schedValid(request.resource.data)
        && (isAdmin() || nowish(request.resource.data.orderAt));
      allow update: if canOrder()
        && consistent(request.resource.data)
        && !changed().hasAny(['createdBy', 'createdAt'])
        && (stamped() || upgradeOnly())
        && (upgradeOnly() || !newlyDispatched() || (hasVehicle() && hasDepot() && hasPhone() && notBeforeItsDay()))
        && (upgradeOnly() || cancelRecordOk())
        && (isAdmin() || (onlyDispatchFields() && dispatchOk()) || dispatchWithVehicle() || holdOk() || cancelOk() || schedOk() || detailsOk());
      allow delete: if isAdmin();
    }

    // Daily totals used by the Summary tab (recalculated by the app after each change)
    match /daysum/{day} {
      allow read: if isMember();
      allow write: if canOrder();
    }

    // Old dispatch records from version 1. Read once by the Admin during the upgrade; kept as a backup.
    match /deliveries/{orderId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
  }
}
